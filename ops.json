{
  "runtime": "node",
  "operations": [
    {
      "id": "install",
      "kind": "portable",
      "run": "mise install",
      "description": "Install the pinned tools with mise."
    },
    {
      "id": "fmt",
      "kind": "portable",
      "run": "node scripts/fmt.mjs",
      "description": "Format the given files, or every tracked source file.",
      "args": true
    },
    {
      "id": "fmt-check",
      "kind": "portable",
      "run": "bun fmt --check scripts tools",
      "description": "Check JavaScript and TypeScript formatting with Bun."
    },
    {
      "id": "lint",
      "kind": "portable",
      "run": "node scripts/lint.mjs",
      "description": "Lint the given files, or run oxlint and flint over the tree.",
      "args": true
    },
    {
      "id": "lint-fix",
      "kind": "portable",
      "run": "node scripts/lint.mjs --fix",
      "description": "Fix what oxlint and flint can fix."
    },
    {
      "id": "typecheck",
      "kind": "portable",
      "run": "bun check",
      "description": "Type check JavaScript and TypeScript with Bun."
    },
    {
      "id": "hooks",
      "kind": "portable",
      "run": "node scripts/hooks.mjs",
      "description": "Install the shared Lefthook hooks and assert the merged jobs."
    },
    {
      "id": "signing-check",
      "kind": "portable",
      "run": "node scripts/signing-check.mjs",
      "description": "Fail when this checkout cannot sign commits (owner hook)."
    },
    {
      "id": "secrets-staged",
      "kind": "portable",
      "run": "mise exec -- gitleaks git --staged --redact --no-banner",
      "description": "Scan the staged diff for secrets with gitleaks."
    },
    {
      "id": "forbidden-files",
      "kind": "portable",
      "run": "node scripts/forbidden-files.mjs",
      "args": true,
      "description": "Reject env files, private keys, kubeconfigs and files over 5 MB."
    },
    {
      "id": "workflows",
      "kind": "portable",
      "run": "node scripts/workflows.mjs",
      "args": true,
      "description": "Run actionlint and zizmor over the given workflows, or every workflow."
    },
    {
      "id": "shellcheck",
      "kind": "portable",
      "run": "node scripts/shellcheck.mjs",
      "args": true,
      "description": "Run shellcheck over the given shell scripts."
    },
    {
      "id": "commit-msg",
      "kind": "portable",
      "run": "node scripts/commit-msg.mjs",
      "args": true,
      "description": "Warn when a commit subject is not a Conventional Commit."
    },
    {
      "id": "hook-pre-push",
      "kind": "portable",
      "run": "node scripts/pre-push.mjs",
      "description": "Read the pushed refs from stdin, run the env guard, and scan the range with gitleaks."
    },
    {
      "id": "pre-push-check",
      "kind": "portable",
      "run": "node scripts/pre-push-check.mjs",
      "description": "Run the fast pre-push subset: type check and operation manifest."
    },
    {
      "id": "deps-refresh",
      "kind": "portable",
      "run": "node scripts/deps-refresh.mjs",
      "args": true,
      "description": "Refresh locked dependencies when a manifest changed."
    },
    {
      "id": "agent-files",
      "kind": "portable",
      "run": "node scripts/agent-files.mjs",
      "description": "Check the .agents/skills tree and its .claude/skills links."
    },
    {
      "id": "aislop",
      "kind": "portable",
      "run": "node scripts/aislop.mjs",
      "description": "Run the AI-slop gate."
    },
    {
      "id": "security",
      "kind": "portable",
      "run": "node scripts/security.mjs",
      "description": "Scan the filesystem with Trivy."
    },
    {
      "id": "secret-scan",
      "kind": "portable",
      "run": "node scripts/secret-scan.mjs",
      "description": "Scan git history for secrets with gitleaks."
    },
    {
      "id": "test",
      "kind": "portable",
      "run": "node scripts/test.mjs",
      "description": "Run every test suite."
    },
    {
      "id": "delivery-receipt",
      "kind": "portable",
      "args": true,
      "run": "node tools/delivery-receipt/cli.mjs",
      "description": "Build a read-only delivery preflight receipt from explicit JSON evidence."
    },
    {
      "id": "coverage",
      "kind": "portable",
      "run": "npx --yes c8 --reporter=lcov --reports-dir=coverage node scripts/test.mjs",
      "description": "Run the suite with coverage and write coverage/lcov.info."
    },
    {
      "id": "test-check-standard",
      "kind": "portable",
      "run": "node scripts/check-standard.test.mjs",
      "description": "Run the hooks-group rule tests over fixtures."
    },
    {
      "id": "test-pre-push",
      "kind": "portable",
      "run": "node scripts/pre-push.test.mjs",
      "description": "Run the pre-push policy tests with stub shared scripts and a stub gitleaks."
    },
    {
      "id": "test-all-checks",
      "kind": "portable",
      "run": "node scripts/all-checks.test.mjs",
      "description": "Run the all-checks aggregate workflow policy tests over local fixtures."
    },
    {
      "id": "test-ruleset-policy",
      "kind": "portable",
      "run": "node scripts/ruleset-policy.test.mjs",
      "description": "Run local ruleset target, payload and explicit auto-merge setting tests."
    },
    {
      "id": "test-patch-coverage",
      "kind": "portable",
      "run": "node scripts/patch-coverage.test.mjs",
      "description": "Run the patch-coverage matcher tests."
    },
    {
      "id": "test-scripting",
      "kind": "portable",
      "run": "node scripts/scripting.test.mjs",
      "description": "Run the scripting conformance rule tests over fixtures."
    },
    {
      "id": "test-subprocess",
      "kind": "portable",
      "run": "node scripts/subprocess.test.mjs",
      "description": "Run the subprocess windowsHide rule tests over fixtures and the check-standard and check-repo matrices."
    },
    {
      "id": "test-proc",
      "kind": "portable",
      "run": "node scripts/proc.test.mjs",
      "description": "Run the process PATH discovery tests without launching discovered commands."
    },
    {
      "id": "test-env",
      "kind": "portable",
      "run": "node scripts/env.test.mjs",
      "description": "Run the env convention rule tests over fixtures."
    },
    {
      "id": "test-required",
      "kind": "portable",
      "run": "node scripts/required.test.mjs",
      "description": "Run the required-check rule tests over fixtures and the check-standard and check-repo matrices."
    },
    {
      "id": "test-repo-maintenance",
      "kind": "portable",
      "run": "node scripts/repo-maintenance-test.mjs",
      "description": "Run the pure repository-maintenance planner tests under a host Python 3.10 or newer."
    },
    {
      "id": "test-repo-maintenance-dispatcher",
      "kind": "portable",
      "run": "node scripts/repo-maintenance.test.mjs",
      "description": "Run the planner dispatcher environment regression checks without launching an interpreter."
    },
    {
      "id": "verify",
      "kind": "portable",
      "run": "node scripts/verify.mjs",
      "description": "Run the local CI mirror: lint, test, aislop, security, and secret scan."
    },
    {
      "id": "prune",
      "kind": "portable",
      "run": "node scripts/prune.mjs",
      "description": "Prune remote-tracking refs and delete local branches merged into main."
    },
    {
      "id": "check",
      "kind": "portable",
      "run": "node scripts/op.mjs check",
      "description": "Validate the operation manifest, recipes, twins, and generated artifacts."
    },
    {
      "id": "check-standard",
      "kind": "portable",
      "args": true,
      "run": "node scripts/check-standard.mjs",
      "description": "Check one repository against the standard and print a matrix."
    },
    {
      "id": "check-repo",
      "kind": "portable",
      "args": true,
      "run": "node scripts/check-repo.mjs",
      "description": "Check one repository against the standard, applying the exception file."
    },
    {
      "id": "audit-fleet",
      "kind": "portable",
      "args": true,
      "run": "node scripts/audit-fleet.mjs",
      "description": "Audit the scripting conformance of every repository in a directory and print one matrix."
    },
    {
      "id": "patch-coverage",
      "kind": "portable",
      "args": true,
      "run": "node scripts/patch-coverage.mjs",
      "description": "Fail when the changed lines are not covered enough."
    },
    {
      "id": "apply-settings",
      "kind": "portable",
      "args": true,
      "run": "node scripts/apply-settings.mjs",
      "description": "Converge repository settings, the owner topic, and public-repo security."
    },
    {
      "id": "apply-rulesets",
      "kind": "portable",
      "args": true,
      "run": "scripts/apply-rulesets.sh",
      "description": "Apply the ruleset JSON to a repository."
    },
    {
      "id": "ruleset-payload",
      "kind": "portable",
      "args": true,
      "run": "node scripts/ruleset-payload.mjs",
      "description": "Print the hard-protection ruleset payload for a repository."
    }
  ]
}
